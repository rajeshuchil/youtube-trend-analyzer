# Backend Environment Variables

# Server
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/youtube-trends
# For production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/youtube-trends

# YouTube API
YOUTUBE_API_KEY=your_youtube_api_key_here

# CORS Configuration
# Add your frontend URLs here (comma-separated for multiple)
FRONTEND_URL=http://localhost:5174
ALLOWED_ORIGIN=https://your-vercel-app.vercel.app

# For Render.com deployment, add these in your Render dashboard:
# FRONTEND_URL=https://your-vercel-app.vercel.app
# ALLOWED_ORIGIN=https://your-custom-domain.com
