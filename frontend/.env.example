# Frontend Environment Variables

# Backend API URL
# Development (using Vite proxy - recommended):
VITE_API_URL=/api

# Development (direct backend call - alternative):
# VITE_API_URL=http://localhost:5000/api

# Production (Render.com):
# VITE_API_URL=https://youtube-trend-analyzer-ry6z.onrender.com/api

# Note: Create a .env.local file for local development
# Vercel will use environment variables set in their dashboard
