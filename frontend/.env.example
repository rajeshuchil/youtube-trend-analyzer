# Frontend Environment Variables

# Backend API URL
# Development:
VITE_API_URL=http://localhost:5000

# Production (update with your deployed backend URL):
# VITE_API_URL=https://your-backend.onrender.com

# Note: 
# - For local development, create a .env file with the development URL
# - For Vercel deployment, set VITE_API_URL in Vercel's environment variables dashboard
# - Make sure to include /api in the URL if your backend uses that prefix

